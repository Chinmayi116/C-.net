using System;

class Program
{
    static void Main()
    {
        int n = 7;
        bool prime = true;

        for (int i = 2; i < n; i++)
        {
            if (n % i == 0)
            {
                prime = false;
                break;
            }
        }

        Console.WriteLine(prime ? "Prime" : "Not Prime");
    }
}
